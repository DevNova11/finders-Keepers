rules_version = '2';

// Finders Keepers — Firebase Storage rules (uses cross-service Firestore lookups).
service firebase.storage {
  match /b/{bucket}/o {

    function canWrite() {
      return request.auth != null;
    }
    function validImage() {
      return request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
    }

    // Item photos (already EXIF-stripped / blurred on device).
    // Uploaded before the item document exists (ids are random UUIDs);
    // once the item exists only its reporter may overwrite them.
    match /items/{itemId}/{file} {
      allow read: if request.auth != null;
      allow create, update: if canWrite() && validImage()
        && (!firestore.exists(/databases/(default)/documents/items/$(itemId))
            || firestore.get(/databases/(default)/documents/items/$(itemId)).data.reporterId == request.auth.uid);
      allow delete: if false;
    }

    // Claim proof photos: claimant + item reporter only.
    // Claim ids are "{itemId}_{claimantUid}".
    match /claims/{claimId}/{file} {
      allow create, update: if canWrite() && validImage()
        && claimId.matches('.*_' + request.auth.uid);
      allow read: if request.auth != null
        && (claimId.matches('.*_' + request.auth.uid)
            || firestore.get(/databases/(default)/documents/claims/$(claimId)).data.itemReporterId == request.auth.uid);
      allow delete: if false;
    }
  }
}
